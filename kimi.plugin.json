{
  "name": "mindie-agent",
  "version": "0.1.11",
  "description": "MindIE Agent for Kimi Code: local knowledge retrieval, optional community contribution, and general remote-dev. No SessionStart auto-configuration.",
  "keywords": [
    "mindie",
    "knowledge",
    "vllm-ascend",
    "remote-dev"
  ],
  "license": "MIT",
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "knowledge": {
      "command": "python3",
      "args": [
        "./scripts/with_runtime.py",
        "mcp_server.py",
        "knowledge"
      ],
      "cwd": "./",
      "toolTimeoutMs": 210000
    },
    "remote": {
      "command": "python3",
      "args": [
        "./scripts/with_runtime.py",
        "mcp_server.py",
        "remote"
      ],
      "cwd": "./",
      "env": {
        "REMOTE_DEV_HARNESS_PROFILE": "kimi"
      },
      "toolTimeoutMs": 660000
    },
    "components": {
      "command": "python3",
      "args": [
        "./scripts/with_runtime.py",
        "mcp_server.py",
        "components"
      ],
      "cwd": "./",
      "toolTimeoutMs": 660000
    }
  },
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "mcp__plugin-mindie-agent_",
      "command": "python3 ./scripts/with_runtime.py bridge.py pretool",
      "timeout": 20
    },
    {
      "event": "Stop",
      "command": "python3 ./scripts/with_runtime.py bridge.py stop",
      "timeout": 20
    }
  ],
  "systemPrompt": "MindIE tools use a fresh request_nonce bound by the native PreToolUse hook. Remote-dev, coordinator, profiler, sim, local diagnostics and factual status are available without knowledge activation. Never pass or invent native session identity.",
  "interface": {
    "displayName": "MindIE Agent",
    "shortDescription": "Domain knowledge, optional public contribution, and general remote-dev for Kimi Code",
    "developerName": "MindIE Agent"
  }
}
